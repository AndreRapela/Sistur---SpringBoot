# Preferencial para backend persistente quando o ambiente possui IPv6
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<senha-do-banco>
# Fallback IPv4 (Session pooler): use o host exibido em Connect no Supabase
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
JWT_SECRET=<minimo-32-caracteres>
ANALYTICS_PRIVACY_SALT=<segredo-distinto-ou-o-mesmo-jwt-em-desenvolvimento>
GOOGLE_CLIENT_ID=<client-id-google-ou-vazio>
# Opcional no fluxo atual
SUPABASE_JWKS_URL=https://<projeto>.supabase.co/auth/v1/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=https://<dominio-do-frontend>
SWAGGER_ENABLED=false
RATE_LIMIT_ENABLED=true
SISTUR_SEED_ENABLED=true
# Use validate em producao somente depois de criar e testar uma baseline SQL completa.
JPA_DDL_AUTO=update
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=10000
DB_VALIDATION_TIMEOUT_MS=5000
DB_INITIALIZATION_FAIL_TIMEOUT_MS=15000
DB_CONNECT_TIMEOUT_SECONDS=10
DB_SOCKET_TIMEOUT_SECONDS=30
# Clima: URLs gratuitas servem para desenvolvimento e avaliação
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_API_KEY=
WEATHER_CACHE_MINUTES=10

package br.gov.noronha.sistur.config;

import org.springframework.amqp.core.Binding;
import org.springframework.amqp.core.BindingBuilder;
import org.springframework.amqp.core.Queue;
import org.springframework.amqp.core.TopicExchange;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

@Configuration
public class RabbitConfig {

    public static final String EXCHANGE_NAME = "sistur.exchange";
    public static final String AI_QUEUE = "ai.recommendation.queue";
    public static final String AI_ROUTING_KEY = "ai.request.#";

    @Bean
    public TopicExchange exchange() {
        return new TopicExchange(EXCHANGE_NAME);
    }

    @Bean
    public Queue aiQueue() {
        return new Queue(AI_QUEUE, true);
    }

    @Bean
    public Binding aiBinding(Queue aiQueue, TopicExchange exchange) {
        return BindingBuilder.bind(aiQueue).to(exchange).with(AI_ROUTING_KEY);
    }
}

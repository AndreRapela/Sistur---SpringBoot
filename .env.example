SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<senha-do-banco>
JWT_SECRET=<minimo-32-caracteres>
GOOGLE_CLIENT_ID=<client-id-google-ou-vazio>
# Opcional no fluxo atual
SUPABASE_JWKS_URL=https://<projeto>.supabase.co/auth/v1/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=https://<dominio-do-frontend>
SISTUR_SEED_ENABLED=true
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
# Clima: URLs gratuitas servem para desenvolvimento e avaliação
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_API_KEY=
WEATHER_CACHE_MINUTES=10
